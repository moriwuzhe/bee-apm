# Store Plugin Definitions
# Format: name=fully.qualified.ClassName

# Legacy stores (backward compatibility - deprecated)
# h2=org.xi.lt.server.infrastructure.store.H2Store
# mysql=org.xi.lt.server.infrastructure.store.MysqlStore
# elasticsearch=org.xi.lt.server.infrastructure.store.ElasticSearchStore
console=org.xi.lt.server.core.store.ConsoleStore

# Unified adapter stores (deprecated - use DDD architecture)
# h2-adapter=org.xi.lt.server.infrastructure.store.h2.H2UnifiedStoreAdapter
# mysql-adapter=org.xi.lt.server.infrastructure.store.mysql.MysqlUnifiedStoreAdapter
# elasticsearch-adapter=org.xi.lt.server.infrastructure.store.elasticsearch.EsUnifiedStoreAdapter

# Spring Data Architecture Adapter (recommended)
spring-data-adapter=org.xi.lt.server.infrastructure.store.adapter.SpringDataStoreAdapter
