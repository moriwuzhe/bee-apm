digraph FlowGraph {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=lightblue];
    edge [color=gray];

    com_example_TestClass_methodD [label="methodD()", fillcolor=lightyellow];
    com_example_TestClass_methodC [label="methodC()", fillcolor=lightyellow];
    com_example_TestClass_methodB [label="methodB()", fillcolor=lightyellow];
    com_example_TestClass_methodA [label="methodA()", fillcolor=lightyellow];
    com_example_TestClass [label="<<TestClass>>", fillcolor=lightgreen];

    com_example_TestClass -> com_example_TestClass_methodA;
    com_example_TestClass -> com_example_TestClass_methodB;
    com_example_TestClass -> com_example_TestClass_methodC;
    com_example_TestClass -> com_example_TestClass_methodD;
    com_example_TestClass_methodA -> com_example_TestClass_methodB;
    com_example_TestClass_methodA -> com_example_TestClass_methodC;
    com_example_TestClass_methodB -> com_example_TestClass_methodD;
}
